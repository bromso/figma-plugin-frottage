{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["../../packages/ui/src/*"],
      "@repo/ui/*": ["../../packages/ui/src/*"]
    },
    "types": ["bun", "chrome"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "build.ts", "chrome.manifest.ts"]
}
